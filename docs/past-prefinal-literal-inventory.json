s coda.'),\n}\nobservations=[]\nfor group in capture['all_original_groups']:\n    for i,text in enumerate(group['original']):\n        for match in re.finditer(r'[가-힣]+',text):\n            if not any((ord(ch)-0xAC00)%28==20 for ch in match[0]):continue\n            occurrence={**group,'text_index':i,'character_span':[match.start(),match.end()]}\n            key=identity(occurrence)\n            row={'source_occurrence':occurrence,'surface':match[0],'contextual_verdict':'unjudged','independent_review':'pending'}\n            if key in owned: row.update(role='primary_structural_proposal',case=owned[key])\n            else:\n                surface,reason=incidental[key];assert surface==match[0]\n                row.update(role='incidental_not_primary_target',reason=reason)\n            observations.append(row)\nassert len(observations)==56\nassert {identity(row['source_occurrence']) for row in observations if row['role']=='primary_structural_proposal'}==set(owned)\nassert {identity(row['source_occurrence']) for row in observations if row['role']=='incidental_not_primary_target'}==set(incidental)\nproducer=Path(__file__)\nreport={'schema_version':1,'preparation_only':True,'source_capture_sha256':hashlib.sha256(capture_path.read_bytes()).hexdigest(),'effective_draft_sha256':hashlib.sha256(draft_path.read_bytes()).hexdigest(),'literal_observations':observations,'counts':{'literal_ss_words':56,'primary_target_proposals':44,'incidental_not_primary_targets':12},'producer':{'text':producer.read_text(),'sha256':hashlib.sha256(producer.read_bytes()).hexdigest()},'scope':'Complete literal scan of this finite original excerpt, independent of analyzer paths. Twelve explicit non-target dispositions distinguish lexical ss codas and other allomorph/construction spellings. These source-target dispositions are authored; contextual senses and independent review remain pending.'}\noutput.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nprint('Inventoried all 56 literal