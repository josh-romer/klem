      "notes": [
        "‘ㄹ’을 제외한 받침 있는 동사 뒤에 붙여 쓴다."
      ],
      "forms": [],
      "senses": [
        {
          "id": "1",
          "definition": "(예사 높임으로) 어떤 동작을 함께 하자는 뜻을 나타내는 종결 어미.",
          "translations": [
            {
              "language": "몽골어",
              "lemma": "(Тохирох үг хэллэг байхгүй байна)",
              "definition": "(ерийн хүндэтгэх үг хэллэг) ямар нэгэн үйлдлийг хамтран хийцгээе хэмээх утгыг илэрхийлдэг төгсгөх нөхцөл."
            },
            {
              "language": "아랍어",
              "lemma": "ـوُبْسيدا",
              "definition": "(صيغة عاديّة التبجيل)لاحقة ختامية  تدلّ على اقتراح المتكلم على المستمع القيام بفعلٍ ما سويًا"
            },
            {
              "language": "중국어",
              "lemma": "(无对应词汇)",
              "definition": "(轻尊)终结语尾。表示让别人一起做某个动作。"
            },
            {
              "language": "베트남어",
              "lemma": "(chúng ta) hãy",
              "definition": "(cách nói kính trọng thông thường) Vĩ tố kết thúc câu thể hiện nghĩa đề nghị cùng thực hiện hành động nào đó."
            },
            {
              "language": "타이어",
              "lemma": "...กันเถอะ, ...เถอะ",
              "definition": "(ใช้ในการยกย่องธรรมดาและเป็นทางการ)วิภัตติปัจจัยลงท้ายประโยคที่ใช้แสดงความหมายว่ามาทำอากัปกริยาใดๆด้วยกันเถอะ"
            },
            {
              "language": "인도네시아어",
              "lemma": "mari, ayo",
              "definition": "(dalam bentuk sopan) akhiran penutup untuk menandai ajakan"
            },
            {
              "language": "러시아어",
              "lemma": "(нет эквивалента)",
              "definition": "(неформально-вежливый стиль) Финитное окончание со значением приглашения к совместному действию."
            },
            {
              "language": "영어",
              "lemma": "-eupsida",
              "definition": "(formal, moderately addressee-raising) A sentence-final ending used to express an intention of doing a certain action together."
            },
            {
              "language": "일본어",
              "lemma": "ましょう",
              "definition": "(中称) ある行動を一緒にしようという意を表す「終結語尾」。"
            },
            {
              "language": "프랑스어",
              "lemma": "(Pas d'expression équivalente)",
              "definition": "(forme honorifique modérée) Terminaison finale indiquant une proposition du locuteur de faire quelque chose avec lui."
            },
            {
              "language": "스페인어",
              "lemma": "(No hay expresión equivalente)",
              "definition": "(TRATAMIENTO HONORÍFICO ORDINARIO) Desinencia de terminación que se usa cuando alguien propone a otro hacer juntos cierta acción."
            }
          ],
          "examples": [
            [
              "모두 좀 빨리 걸읍시다."
            ],
            [
              "우리의 권리를 찾읍시다."
            ],
            [
              "우리 올해는 책을 좀 읽읍시다."
            ],
            [
              "좀 쉬다 갈까요?",
              "네, 여기 잠깐 앉읍시다."
            ]
          ],
          "notes": [],
          "patterns": []
        }
      ]
