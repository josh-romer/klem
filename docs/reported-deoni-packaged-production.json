    "text": "\"\"\"Verify actual packaged CLI outputs; transfer gold only by full WordAnalysis equality.\"\"\"\nimport hashlib,json,sys,unicodedata\nfrom pathlib import Path\nROOT=Path('/home/josh/projects/klem');sys.path.insert(0,str(ROOT/'tools'))\nfrom copula_expectation_production import read,sha,replay\nfrom doeda_native_corpora import words_from_cli\nRECEIPT=Path('/tmp/klem-reported-deoni-package-nix.json')\nOUTPUT=Path('/tmp/klem-reported-deoni-packaged-production.json');assert not OUTPUT.exists()\npackage=json.loads(RECEIPT.read_text());assert package['state']=='passed' and package['exit_code']==0 and package['snapshot_unchanged']\nassert len(package['outputs'])==2\nrust=[Path(p) for p in package['outputs'] if (Path(p)/'bin/klem').is_file()]\nassets=[Path(p) for p in package['outputs'] if (Path(p)/'share/klem-web/index.html').is_file()]\nassert len(rust)==len(assets)==1;CLI=rust[0]/'bin/klem';DB=ROOT/'data/dictionaries/krdict/krdict.db'\nassert not (CLI.parent/'examples/evaluate').exists(),'Revisit claimed corpus method if package layout changes'\nmain=read('docs/reported-deoni-main-production.json');assert main['state']=='passed'\npaths=['docs/reported-deoni-main-production.json','docs/reported-deoni-prototype-source-streams.json.gz','docs/reported-deoni-prototype-corpora.json.gz','docs/reported-deoni-prototype-broad.json.gz']\nfrozen={p:sha(ROOT/p) for p in paths};binaries={str(p):sha(p) for p in [CLI,DB]}\nsource=read(paths[1]);runs=[]\nfor old in main['source_runs']:\n request=unicodedata.normalize(old['encoding'],source['input'])\n assert hashlib.sha256(request.encode()).hexdigest()==old['input_sha256']\n result=replay([str(CLI),*old['command'][1:]],old['sha256'],old['records'],request)\n runs.append({key:old[key] for key in ['encoding','mode','input_sha256']}|result)\n print('packaged source',old['encoding'],old['mode'],old['records'],flush=True)\ncorpus=read(paths[2]);words=words_from_cli(CLI,sorted(corpus['after_words']))\nassert words==corpus['after_words'] and len(words)==32096\nword_hash=hashlib.sha256(json.dumps(words,ensure_ascii=False,sort_keys=True).encode()).hexdigest();assert word_hash==main['corpus_word_sha256']\nreferences=[]\nfor old in corpus['corpora']:\n assert sha(ROOT/old['source'])==old['source_sha256']\n references.append({key:old[key] for key in ['corpus','partition','source','source_sha256','report_lines']}|{'reference_evaluator_jsonl_sha256':hashlib.sha256(old['after_jsonl'].encode()).hexdigest()})\nbroad_runs=[]\nfor old in main['broad_runs']:\n assert sha(old['source'])==old['source_sha256']\n result=replay([str(CLI),*old['command'][1:]],old['sha256'],old['records'])\n broad_runs.append({key:old[key] for key in ['source','source_sha256','mode']}|result)\n print('packaged broad',old['mode'],old['records'],flush=True)\nlegacy=[]\nfor old in main['legacy_source_runs']:\n original=read(f\"docs/{old['family']}-cohort.json.gz\")\n request=unicodedata.normalize(old['encoding'],original['input'])\n assert hashlib.sha256(request.encode()).hexdigest()==old['input_sha256']\n result=replay([str(CLI),*old['command'][1:]],old['sha256'],old['records'],request)\n legacy.append({key:old[key] for key in ['family','encoding','mode','input_sha256','prior_stream_sha256']}|result)\n print('packaged legacy',old['family'],old['encoding'],old['mode'],old['records'],flush=True)\nassert len(runs)==6 and sum(r['records'] for r in runs)==378774\nassert len(broad_runs)==8 and sum(r['records'] for r in broad_runs)==1128312\nassert len(legacy)==12 and sum(r['records'] for r in legacy)==309660\nassert len(references)==4 and sum(r['report_lines']-1 for r in references)==66570\nassert all(sha(ROOT/p)==digest for p,digest in frozen.items()) and all(sha(p)==digest for p,digest in binaries.items())\nproducer=Path(__file__)\nreport={'schema_version':1,'state':'passed','prototype_parity':True,'inputs_unchanged':True,'nix_outputs':{'klem':str(rust[0]),'web-assets':str(assets[0])},'package_receipt_sha256':sha(RECEIPT),'frozen_inputs':frozen,'binaries':binaries,'source_runs':runs,'broad_runs':broad_runs,'legacy_source_runs':legacy,'corpus_words':len(words),'corpus_word_sha256':word_hash,'corpus_reference_runs':references,'corpus_validation':{'method':'Exact packaged CLI WordAnalysis equality for every original gold surface, tied to the independently verified evaluator results; no packaged evaluator executable is claimed.','verified_gold_rows':66570},'producer':{'text':producer.read_text(),'sha256':sha(producer)},'scope':'Actual packaged CLI equality for all18 source/legacy and eight broad streams plus32096 full original words. Gold transfer is explicitly distinguished from running an evaluator in the package. Contextual and independent linguistic certification remain separate.'}\nOUTPUT.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print('Actual packaged source/broad/legacy/corpus-word parity passes.',flush=True)\n",
