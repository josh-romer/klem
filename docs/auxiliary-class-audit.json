  "decisions": [
    {
      "case": "negative class inheritance",
      "source": "https://www.korean.go.kr/front/onlineQna/onlineQnaView.do?mn_id=216&pageIndex=1&qna_seq=312012",
      "decision": "Known adjective auxiliaries keep their class through 지 않다/아니하다/못하다, including internal particles and contracted negatives."
    },
    {
      "case": "보다",
      "source_ids": [
        "krdict:62171",
        "krdict:62249"
      ],
      "decision": "어/다가 uses are verbs; 는가/은가/나/을까 uses are adjectives. 고/다 remain ambiguous."
    },
    {
      "case": "하다",
      "decision": "어/게/어야/으려/으려고/고자/으면 uses are verbs. 고 and nominalizing links remain ambiguous."
    },
    {
      "case": "못하다",
      "decision": "다/다가 use is adjectival; 지 inherits a known preceding class."
    },
    {
      "case": "양하다",
      "decision": "Both auxiliary classes remain possible."
    },
    {
      "case": "없다",
      "source_ids": [
