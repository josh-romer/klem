      "senses": [
        {
          "id": "1",
          "definition": "앞말이 뜻하는 상태에 이를 수 없음을 나타내는 말.",
          "translations": [
            {
              "language": "영어",
              "lemma": "motada",
              "definition": "An auxiliary adjective used to indicate that the state described by the preceding words cannot be reached."
            }
          ],
          "examples": [
            [
              "지수는 또래보다 영리하지는 못했지만 누구보다 착하고 순한 아이였다."
            ],
            [
              "어린 동생을 집에 혼자 두고 온 동생 때문에 나는 마음이 편하지 못했다."
            ],
            [
              "우리는 그들이 옳지 못한 행동을 하는 것을 가만히 지켜볼 수만은 없었다."
            ],
            [
              "승규에 대한 주변 평판이 왜 그리 좋지 못하지?",
              "평소에 사람들한테 민폐를 많이 끼치잖아."
            ]
          ],
          "notes": [
            "형용사 뒤에서 '-지 못하다'로 쓴다."
          ],
          "patterns": []
        },
        {
          "id": "2",
          "definition": "앞말이 나타내는 행동이나 상태가 극에 달해 더 이상 유지할 수 없음을 나타내는 말.",
          "translations": [
            {
              "language": "영어",
              "lemma": "motada",
              "definition": "An auxiliary adjective used to indicate that the action or state described by the preceding words is too extreme to be sustained."
            }
          ],
          "examples": [
            [
              "바닥에 흥건히 고인 피는 붉다 못해 검은 빛까지 띠고 있었다."
            ],
            [
              "그녀는 희다 못해 푸른빛이 감도는 하얀색 옷을 아래위로 입고 있었다."
            ],
            [
              "경찰들의 끈질긴 심문을 견디다 못한 그는 결국 모든 죄를 자백하고 말았다."
            ],
            [
              "나는 그들의 힘겨운 삶의 모습을 보다 못해 눈물을 흘리며 고개를 돌리고 말았다."
            ],
            [
              "수학 문제는 다 풀었어?",
              "휴, 두 시간이나 붙잡고 있다 못해 결국 수학 선생님을 찾아갔어."
            ],
            [
              "산 정상에 오르니까 기분이 어때요?",
              "아름답다 못해 감동적이기까지 합니다."
            ]
          ],
          "notes": [
            "주로 '-다(가) 못하여'로 쓴다."
          ],
