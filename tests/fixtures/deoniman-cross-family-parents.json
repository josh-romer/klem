  "producer": {
    "text": "\"\"\"Freeze exact existing parents for new report paths in older source cohorts.\"\"\"\nimport copy,gzip,hashlib,json,subprocess\nfrom pathlib import Path\nROOT=Path('/home/josh/projects/klem');P=Path('/tmp/klem-deoniman-prototype');old=Path('/nix/store/wc9jds3jyx2svx6gyyy7k88zvhqgx4qa-klem-0.1.0/bin/klem');new=ROOT/'web/test-results/deoniman-prototype-cargo/debug/klem';words=set()\nfor name in ['degree-rimankeum','counterfactual-ryeon']:\n source=json.loads((ROOT/f'tests/fixtures/{name}-sources.json').read_text());words.update(w for w in source['source_cohort_before_analyses'] if any(w.endswith(s) for s in ['더니','더니만','더니마는']))\nsource=json.loads((ROOT/'tests/fixtures/friendly-command-sources.json').read_text());words.update(w for w in source['before_analyses'] if any(w.endswith(s) for s in ['더니','더니만','더니마는']))\nparents={};checks={};forms={'더니만':'더니','더니마는':'더니','다더니':'다던','는다더니':'는다던','다더니만':'다던','다더니마는':'다던','는다더니만':'는다던','는다더니마는':'는다던'}\nfor word in sorted(words):\n actual=json.loads(subprocess.check_output([str(new),'word',word],text=True));records=[]\n for a in actual['analyses']:\n  markers=set(a['rules'])&{'ending.reported_deoni','ending.deoniman'}\n  if not markers:continue\n  indexes=[i for i,m in enumerate(a['morphemes']) if m['kind']=='ending' and m['form'] in forms];assert len(indexes)==1,(word,a);i=indexes[0];form=a['morphemes'][i]['form'];tail=next(s for s in ['더니마는','더니만','더니'] if word.endswith(s));companion=word[:-len(tail)]+('더니' if form in ['더니만','더니마는'] else '던')\n  if companion not in parents:parents[companion]=json.loads(subprocess.check_output([str(old),'word',companion],text=True))\n  inverse=copy.deepcopy(a);inverse['rules']=sorted(set(inverse['rules'])-markers|({'ending.reporting_retrospective'} if form not in ['더니만','더니마는'] else set()));inverse['morphemes'][i]['form']=forms[form];assert inverse in parents[companion]['analyses'],(word,companion,a,inverse);records.append({'analysis':a,'companion':companion,'inverse':inverse})\n if records:checks[word]=records\nout=Path('/tmp/klem-deoniman-cross-family-parents-expanded.json');assert not out.exists();producer=Path(__file__);out.write_text(json.dumps({'schema_version':1,'words':checks,'actual_prior_companions':parents,'old_cli_sha256':hashlib.sha256(old.read_bytes()).hexdigest(),'new_cli_sha256':hashlib.sha256(new.read_bytes()).hexdigest(),'producer':{'text':producer.read_text(),'sha256':hashlib.sha256(producer.read_bytes()).hexdigest()},'scope':'Exact existing companion provenance for new paths in older source cohorts; does not certify speculative lexical heads or contextual senses.'},ensure_ascii=False,indent=2)+'\\n');print('Preserved',len(checks),'overlap words,',sum(len(v) for v in checks.values()),'new paths,',len(parents),'actual old companions.')\n",
