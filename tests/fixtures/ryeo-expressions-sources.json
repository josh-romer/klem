          "notes": [],
          "patterns": []
        },
        {
          "id": "2",
          "definition": "앞으로 어떤 일이 일어날 것 같았으나 그렇게 되지 못하거나 중단됨을 나타내는 표현.",
          "translations": [
            {
              "language": "영어",
              "lemma": "-ryeodeon",
              "definition": "An expression used to indicate that something that is about to happen is stopped or changed in the middle."
            }
          ],
          "examples": [
