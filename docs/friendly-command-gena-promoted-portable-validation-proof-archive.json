  "producer": {
    "text": "\"\"\"Retain complete failed and passed portable validation without rewriting either.\"\"\"\nimport gzip\nimport hashlib\nimport json\nfrom pathlib import Path\nP = Path(__file__).resolve().parent\nW = P.parent / 'friendly-command-gena'\nOUT = W / 'docs/friendly-command-gena-promoted-portable-validation-proof-archive.json'\nassert not OUT.exists()\nsha = lambda b: hashlib.sha256(b).hexdigest()\npassed = json.loads((P / 'friendly-command-gena-promoted-portable-audit-retry1.json').read_bytes())\nfailed = json.loads((P / 'friendly-command-gena-promoted-portable-audit.json').read_bytes())\nassert passed['state'] == 'passed' and (passed['controls'], passed['failures'], passed['errors']) == (46, 0, 0)\nassert all(passed[k] for k in ['source_unchanged', 'head_unchanged', 'index_unchanged', 'protected_binaries_unchanged'])\nassert failed['state'] == 'failed' and (failed['controls'], failed['failures'], failed['errors']) == (46, 0, 1)\npaths = {name: P / name for name in [\n    'archive_gena_portable_first_failure.py', 'gena-promoted-portable-first-failure-originals.json',\n    'validate_gena_portable_promoted_installed.py', 'friendly-command-gena-promoted-portable-audit.json',\n    'friendly-command-gena-promoted-portable-audit.log', 'validate_gena_portable_promoted_installed_retry1.py',\n    'friendly-command-gena-promoted-portable-audit-retry1.json', 'friendly-command-gena-promoted-portable-audit-retry1.log',\n    'gena-promoted-portable-before-inventory-queue.json.gz']}\noriginals = json.loads((P / 'gena-promoted-portable-first-failure-originals.json').read_bytes())\nfor row in originals['files'].values():\n    path = Path(row['path'])\n    packed = path.read_bytes()\n    assert sha(packed) == row['archive_sha256'] and sha(gzip.decompress(packed)) == row['source_sha256']\n    paths[path.name] = path\nfor name in ['tools/friendly_command_gena_promoted_installed_audit.py', 'tools/friendly_command_gena_promoted_streams.py', 'tools/test_friendly_command_gena_promoted_installed_audit.py']:\n    assert sha((W / name).read_bytes()) == passed['source_inputs'][name]\n    paths[name.replace('/', '-')] = W / name\ndestination = W / 'docs/friendly-command-gena-promoted-portable-validation-proof'\ndestination.mkdir()\nfiles = {}\nfor name, path in sorted(paths.items()):\n    raw = path.read_bytes(); packed = gzip.compress(raw, mtime=0)\n    target = destination / (name + '.gz'); target.write_bytes(packed)\n    assert gzip.decompress(target.read_bytes()) == raw\n    files[name] = dict(path=str(target.relative_to(W / 'docs')), source_sha256=sha(raw), archive_sha256=sha(packed), bytes=len(raw))\nOUT.write_text(json.dumps(dict(state='complete-failed-and-passed-portable-validation-preserved', files=files,\n                              controls=46, original33_test_bodies_unchanged=True,\n                              failed_original_remains_failed=True,\n                              complete_current_source_and_protected_binaries_unchanged=True,\n                              producer=dict(text=Path(__file__).read_text(), sha256=sha(Path(__file__).read_bytes())),\n                              scope='Portable proof validation only; committed selected-source verification, main integration and contextual independent review are separate.'), indent=2) + '\\n')\nprint(json.dumps(dict(files=len(files), manifest_sha256=sha(OUT.read_bytes()))))\n",
    "sha256": "51181885378bc6888b5f9cfb8e0a88fe519b894515857f73d8a00dd080b54214"
