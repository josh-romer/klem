  "producer": {
    "text": "\"\"\"Retain the sole observed corpus hypothesis alongside unchanged original gold.\"\"\"\nimport gzip\nimport hashlib\nimport json\nfrom pathlib import Path\n\nP = Path(__file__).resolve().parent\nROOT = P.parents[1]\nO = P / 'friendly-hortative-sena-corpus-observations.json'\nassert not O.exists()\nsha = lambda b: hashlib.sha256(b).hexdigest()\ncohort_path = P / 'friendly-hortative-sena-cohorts.json.gz'\ngold_path = P / 'friendly-hortative-sena-corpora.json.gz'\ncohort = json.loads(gzip.decompress(cohort_path.read_bytes()))\ngold = json.loads(gzip.decompress(gold_path.read_bytes()))\nassert cohort['inputs_unchanged'] and gold['inputs_unchanged']\nassert [r['surface'] for r in cohort['individual_changed_words']] == ['중세나']\nassert next(r for r in cohort['runs'] if r['family'] == 'history')['changed_words'] == []\nrun = next(r for r in gold['runs'] if r['corpus'] == 'kaist' and r['partition'] == 'test')\nrow = next(r for r in map(json.loads, run['jsonl'].splitlines()) if r.get('surface') == '중세나')\nassert row == dict(id='id:MH2_0180-s63/5', surface='중세나', expected=['중세'],\n                   matched=True, recovered=1, recovered_sets=[[0]])\npath = ROOT / run['source']\nraw = path.read_bytes()\nassert sha(raw) == run['source_sha256']\nblock = next(b for b in raw.split(b'\\n\\n') if b'# sent_id = MH2_0180-s63\\n' in b)\nstart = raw.index(block)\nfields = next(line.decode().split('\\t') for line in block.splitlines() if line.startswith(b'5\\t'))\nassert fields[1:5] == ['중세나', '중세+나', 'CCONJ', 'ncn+jcj']\nchange = cohort['individual_changed_words'][0]\nassert len(change['new_paths']) == 1\nnew = change['new_paths'][0]\nassert [l['text'] for l in new['lemmas']] == ['중다']\nassert new['morphemes'] == [dict(form='세나', kind='ending')]\nassert 'ending.friendly_hortative.sena' in new['rules']\nassert [p for p in change['after']['analyses'] if p in change['before']['analyses']] == change['before']['analyses']\nrecord = dict(\n    state='single-unjudged-Sena-corpus-hypothesis-original-annotation-preserved',\n    producer=dict(text=Path(__file__).read_text(), sha256=sha(Path(__file__).read_bytes())),\n    source=str(path.relative_to(ROOT)), source_sha256=sha(raw),\n    cohort_sha256=sha(cohort_path.read_bytes()), gold_sha256=sha(gold_path.read_bytes()),\n    observations_precede_runtime=False, historical_fixture_words_changed=0,\n    historical_allowances_assigned=False,\n    items=[dict(id='friendly-hortative-sena-kaist-MH2_0180-s63-5',\n                complete_original_conllu_block=block.decode(), sentence_byte_start=start,\n                complete_original_token_fields=fields, original_gold_row=row,\n                complete_original_word_analysis=change['before'], current_word_analysis=change['after'],\n                new_unjudged_paths=change['new_paths'], contextual_verdict='unjudged',\n                independent_korean_review='pending')],\n    shared_cases_reviews_changed=False, full_coverage_complete=False)\nO.write_text(json.dumps(record, ensure_ascii=False, indent=2) + '\\n')\nassert sha(path.read_bytes()) == run['source_sha256']\nprint('Recorded exact original KAIST sentence/token/gold and one unjudged 중다+세나 hypothesis; no historical allowance or gold changes.', flush=True)\n",
