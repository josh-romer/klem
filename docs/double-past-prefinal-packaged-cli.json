    "text": "\"\"\"Replay all archived full-source and named word outputs with the actual Nix CLI.\"\"\"\nimport gzip,hashlib,json,subprocess,unicodedata\nfrom pathlib import Path\nroot=Path('/home/josh/projects/klem');output=Path('/tmp/klem-double-past-prefinal-packaged-cli.json')\nassert not output.exists()\ngate=json.loads(Path('/tmp/klem-double-past-prefinal-package-nix.json').read_text())\nassert gate['state']=='passed' and gate['exit_code']==0 and gate['snapshot_unchanged']\nassert all(hashlib.sha256((root/name).read_bytes()).hexdigest()==v['sha256'] for name,v in gate['snapshot']['files'].items())\npackage=next(p for p in gate['outputs'] if p.endswith('-klem-0.1.0'));cli=Path(package)/'bin/klem'\nsource_path=root/'docs/double-past-prefinal-source-discovery.json.gz';draft_path=root/'docs/double-past-prefinal-judgments.json'\nsource=json.loads(gzip.decompress(source_path.read_bytes()));draft=json.loads(draft_path.read_text())\ndef sha(p):\n h=hashlib.sha256()\n with Path(p).open('rb') as f:\n  for c in iter(lambda:f.read(1048576),b''):h.update(c)\n return h.hexdigest()\nfrozen={str(cli):sha(cli),**{p:sha(p) for p in source['frozen_inputs']}}\nassert all(frozen[p]==h for p,h in source['frozen_inputs'].items())\nold=next(p for p in source['frozen_inputs'] if p.endswith('/bin/klem'))\nruns=[]\nfor run in source['runs']:\n command=[str(cli),*run['command'][1:]]\n result=subprocess.run(command,cwd=root,input=unicodedata.normalize(run['encoding'],source['input']).encode(),capture_output=True,check=True)\n assert result.stdout.decode()==run['jsonl'] and len(result.stdout.splitlines())==181\n runs.append({'encoding':run['encoding'],'mode':run['mode'],'command':command,'exit_code':0,'records':181,'sha256':hashlib.sha256(result.stdout).hexdigest(),'exact_archived_output':True})\nprobes=[]\nfor run in draft['probes']:\n command=[str(cli),*run['command'][1:]];result=subprocess.run(command,cwd=root,capture_output=True,check=True)\n assert result.stdout.decode()==run['json']\n probes.append({'case':run['case'],'encoding':run['encoding'],'mode':run['mode'],'command':command,'exit_code':0,'sha256':hashlib.sha256(result.stdout).hexdigest(),'exact_archived_output':True})\nassert len(runs)==6 and len(probes)==68 and all(sha(p)==h for p,h in frozen.items())\nreport={'schema_version':1,'state':'passed','exit_code':0,'package':package,'package_receipt_sha256':sha('/tmp/klem-double-past-prefinal-package-nix.json'),'source_capture_sha256':sha(source_path),'judgments_sha256':sha(draft_path),'cli_bytes_identical_to_original':frozen[str(cli)]==frozen[old],'frozen_inputs':frozen,'inputs_unchanged':True,'runs':runs,'probes':probes,'producer':{'text':Path(__file__).read_text(),'sha256':sha(__file__)},'scope':'Six actual packaged181-frame source streams and68 exact raw/compatible NFC/NFD word probes preserve original outputs. Named implementation cap remains separate from dictionary-certified spelling boundaries.'}\noutput.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print('Actual packaged CLI:6x181 exact source frames;68 exact word outputs;binary equality:',report['cli_bytes_identical_to_original'],flush=True)\n",
